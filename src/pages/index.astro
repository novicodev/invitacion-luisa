---
const eventDate = new Date('2026-10-03T19:00:00-05:00');
const phone = '573143288552';
const message = encodeURIComponent('Hola, confirmo mi asistencia a los XV años de Luisa Fernanda.');
---
<!doctype html><html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#6f0d1d" /><title>Mi grandioso día · Luisa Fernanda</title></head><body>
<main>
<section class="cover"><div class="cover-art" aria-hidden="true"></div><div class="cover-copy"><p class="eyebrow">Una noche para recordar</p><p class="small-title">Mis</p><h1>XV</h1><p class="name">Luisa Fernanda</p><p class="date">03 · 10 · 2026</p><a href="#invitacion" class="scroll-arrow" aria-label="Continuar a la invitación">↓</a></div></section>
<section id="invitacion" class="intro section"><p class="kicker">Con mucha alegría</p><p class="parents">Andrea y Abraham</p><p class="lead">tienen el honor de invitarte a celebrar<br />los quince años de su hija</p><h2>Luisa Fernanda</h2><p class="copy">Hay momentos que se vuelven eternos cuando se comparten con las personas que más queremos. Acompáñame a celebrar esta nueva etapa, una noche llena de ilusión, música y recuerdos.</p><p class="signature">Con cariño,<br /><strong>Luisa</strong></p></section>
<section class="date-section section"><p class="kicker">Reserva la fecha</p><div class="date-grid"><div><b>03</b><span>octubre<br /><small>2026</small></span></div><div><b>7:00</b><span>de la noche<br /><small>Recepción</small></span></div></div><div class="countdown" data-target={eventDate.toISOString()}><span><b data-days>00</b>días</span><span><b data-hours>00</b>horas</span><span><b data-minutes>00</b>minutos</span><span><b data-seconds>00</b>segundos</span></div></section>
<section class="gallery section"><div><p class="kicker">Una noche para recordar</p><h2>El comienzo de<br /><em>un nuevo capítulo</em></h2><p>Tu presencia hará que este día sea aún más especial.</p></div><div class="visual-card"><span class="ornament">✦</span><span class="big-xv">XV</span><span class="ornament">✦</span><p>Una celebración<br />hecha para soñar</p></div></section>
<section class="details section"><p class="kicker">Detalles importantes</p><div class="cards"><article><span>✦</span><h3>Vestuario</h3><p><strong>Formal</strong><br />El rojo está reservado para la quinceañera.</p></article><article><span>♡</span><h3>Lluvia de sobres</h3><p>Tu compañía es nuestro regalo más valioso.</p></article></div></section>
<section class="rsvp section"><p class="kicker">Será un placer verte</p><h2>¿Nos<br /><em>acompañas?</em></h2><p>Confirma tu asistencia antes del<br /><strong>26 de septiembre de 2026</strong></p><a class="button" href={`https://wa.me/${phone}?text=${message}`} target="_blank" rel="noreferrer">Confirmar por WhatsApp ↗</a></section><footer><p>#MiGrandiosoDía</p><strong>Luisa Fernanda · XV</strong></footer></main>
<audio id="audio" src="/barbie-12-princesas.mp3" loop preload="none"></audio><button id="music" aria-label="Reproducir música">♫ Música</button>
<script is:inline>const box=document.querySelector('[data-target]');const tick=()=>{const d=Math.max(0,new Date(box.dataset.target)-Date.now());['days','hours','minutes','seconds'].forEach((k,i)=>document.querySelector('[data-'+k+']').textContent=String([d/864e5,d/36e5%24,d/6e4%60,d/1e3%60][i]|0).padStart(2,'0'))};tick();setInterval(tick,1000);const audio=document.querySelector('#audio'),music=document.querySelector('#music');music.onclick=async()=>{if(audio.paused){await audio.play();music.textContent='❚❚ Pausar'}else{audio.pause();music.textContent='♫ Música'}};</script></body></html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Italianno&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');:root{--wine:#6f0d1d;--red:#a51e32;--cream:#fbf4ec;--ink:#28171a;--gold:#c9a46a;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font:16px/1.65 var(--sans)}main{overflow:hidden}.section{padding:clamp(5rem,11vw,9rem) clamp(1.4rem,8vw,9rem)}.kicker{margin:0 0 1rem;color:var(--gold);font-size:.7rem;letter-spacing:.25em;text-transform:uppercase}.hero{min-height:100svh;position:relative;display:grid;place-items:end center;padding:8vh 1rem;text-align:center;color:#fff}.hero-photo,.veil{position:absolute;inset:0}.hero-photo{background:radial-gradient(circle at 50% 15%,#b52b42 0,#6f0d1d 48%,#26060d 100%)}.veil{background:linear-gradient(180deg,#25070d22 25%,#26060de8 100%)}.hero-content{position:relative;z-index:1;max-width:760px}.hero .kicker{font-size:.78rem;letter-spacing:.38em;margin-bottom:2rem}.roman{font:italic 3rem/1 var(--serif);letter-spacing:.12em;margin:0;color:#f7ddac}.hero h1{font:400 clamp(5rem,13vw,9.5rem)/.78 var(--serif);margin:1rem 0 2.6rem;letter-spacing:-.07em}.hero h1 em{display:inline-block;font:400 .9em/0.7 Italianno,cursive;letter-spacing:.01em;color:#f1c981;text-shadow:0 2px 20px #3d0710aa}.hero-date{letter-spacing:.38em;font-size:.7rem;font-weight:500}.down{display:block;color:#f1c981;text-decoration:none;font:2rem var(--serif);margin-top:4rem;animation:float 2s infinite}@keyframes float{50%{transform:translateY(8px)}}.intro{text-align:center}.parents{font:italic 1.2rem var(--serif);margin:.5rem}.lead{color:#725b5b}.intro h2{font:400 clamp(3rem,8vw,6rem) Italianno,cursive;color:var(--red);margin:.3rem 0 2rem}.copy{max-width:590px;margin:auto;color:#5b4748}.signature{font:italic 1.2rem var(--serif);margin-top:2rem}.date-section{background:var(--wine);color:#fff;text-align:center}.date-grid{display:flex;justify-content:center;gap:clamp(3rem,10vw,8rem);margin:2rem 0 3rem}.date-grid div{display:flex;align-items:center;gap:.7rem}.date-grid b{font:400 clamp(4rem,10vw,7rem) var(--serif);color:#efc982;line-height:.8}.date-grid span{text-align:left;font:1.1rem var(--serif);line-height:1.2}.date-grid small{color:#e3cbb4}.countdown{display:flex;justify-content:center;gap:clamp(1rem,5vw,3rem)}.countdown span{font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;color:#e3cbb4}.countdown b{display:block;font-size:2rem;color:#efc982}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}.gallery h2,.details h2,.rsvp h2{font:400 clamp(2.5rem,6vw,4.5rem)/1.05 var(--serif);margin:0;color:var(--wine)}em{color:var(--red)}.visual-card{min-height:390px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;background:radial-gradient(circle at 50% 35%,#a51e32 0,#6f0d1d 58%,#360610 100%);border:12px solid #efc982;outline:1px solid #6f0d1d;outline-offset:-24px;color:#efc982;text-align:center}.visual-card .ornament{font-size:1.6rem}.big-xv{font:400 clamp(7rem,18vw,12rem)/.8 var(--serif);letter-spacing:-.1em}.visual-card p{font:italic 1.1rem var(--serif);line-height:1.25;margin:1rem 0 0}.details{text-align:center;background:#f2e3d4}.cards{display:grid;grid-template-columns:repeat(2,minmax(220px,360px));justify-content:center;gap:1.5rem}.cards article{padding:2rem 1rem;background:#fffaf5;border:1px solid #e7cda9;box-shadow:7px 7px 0 #d4b48b}.cards span{color:var(--red);font-size:1.8rem}.cards h3{font:400 1.6rem var(--serif);margin:.2rem}.cards p{color:#6d5757}.rsvp{background:var(--wine);color:#fff;text-align:center}.rsvp h2{color:#fff;margin-bottom:1.3rem}.rsvp h2 em{color:#efc982}.rsvp p{color:#e3cbb4}.button{display:inline-block;margin-top:1rem;padding:.9rem 1.5rem;border:1px solid #efc982;color:#efc982;text-decoration:none;text-transform:uppercase;letter-spacing:.1em;font-size:.75rem}.button:hover{background:#efc982;color:var(--wine)}footer{background:#3a0710;color:#e0b97b;text-align:center;padding:3rem 1rem}footer p{letter-spacing:.15em;margin:0 0 .5rem;font-size:.8rem}footer strong{font:italic 1.2rem var(--serif);color:#fff}#music{position:fixed;right:1rem;bottom:1rem;z-index:5;background:#fffaf5;color:var(--wine);border:1px solid #e7cda9;padding:.7rem 1rem;box-shadow:4px 4px 0 #d4b48b;cursor:pointer}@media(max-width:700px){.gallery{grid-template-columns:1fr;gap:2rem}.cards{grid-template-columns:1fr}.date-grid{gap:2rem}.date-grid b{font-size:4rem}.countdown{gap:.7rem}.countdown b{font-size:1.5rem}.hero .kicker{font-size:.62rem;letter-spacing:.28em}.roman{font-size:2.4rem}.hero h1{font-size:clamp(4.4rem,18vw,7rem);margin:1rem 0 2.2rem}.hero-date{font-size:.6rem;letter-spacing:.25em}}
</style>
<style is:global>.cover-art:before,.cover-art:after{display:none!important}</style>
<style is:global>
.cover{min-height:100svh;position:relative;display:grid;place-items:end center;padding-bottom:7vh;text-align:center;color:#fbf4ec;background:var(--wine);overflow:hidden}.cover-art{position:absolute;inset:0;background:radial-gradient(70% 55% at 50% 12%,#b52b42 0%,#6f0d1d 52%,#26060d 100%)}.cover-art:before{content:'✦';position:absolute;top:14%;left:12%;font-size:3rem;color:#efc98244;transform:rotate(18deg)}.cover-art:after{content:'✦';position:absolute;right:12%;bottom:28%;font-size:4rem;color:#efc98233;transform:rotate(-18deg)}.cover:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#6f0d1d00,#26060de8)}.cover-copy{position:relative;z-index:1;width:min(92%,650px)}.cover .eyebrow{color:#f1d39a}.small-title{font:italic 1.6rem var(--serif);margin:4rem 0 0}.cover h1{font:clamp(10rem,35vw,19rem)/.8 var(--serif);font-weight:400;letter-spacing:-.08em;margin:.4rem 0;color:#f7e5c5;text-shadow:0 2px 20px #26060d88}.name{font:italic clamp(4.5rem,16vw,10rem)/.85 Italianno,cursive;letter-spacing:.01em;margin:3.5rem 0 1.15rem;color:#f6d28e;text-shadow:0 2px 18px #26060dcc}.date{margin-top:1.6rem;letter-spacing:.2em;color:#ead6b7}.scroll-arrow{display:inline-block;margin-top:5rem;color:#efc982;text-decoration:none;font:2rem/1 var(--serif);animation:float 2s ease-in-out infinite}@media(max-width:700px){.cover h1{font-size:clamp(9rem,35vw,14rem)}.name{font-size:clamp(4.2rem,17vw,7rem)}}
</style>
